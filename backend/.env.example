# PostgreSQL connection used by SQLAlchemy
DATABASE_URL=postgresql+psycopg://moneqra:moneqra@localhost:5432/moneqra

# Keep demo/simulation mode enabled only for local or explicitly controlled demo environments
MONEQRA_SIMULATION_MODE=false

# Comma-separated browser origins allowed to call the FastAPI backend
MONEQRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Replace these values with strong secrets in production
MONEQRA_TOKEN_SECRET=replace-with-a-long-random-secret
MONEQRA_DEMO_API_KEY_SECRET=replace-with-a-long-random-secret

# Replay protection window for signed provider webhooks
MONEQRA_WEBHOOK_REPLAY_WINDOW_SECONDS=300
